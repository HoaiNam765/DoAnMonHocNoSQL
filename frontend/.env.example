# Cấu hình Firebase Web SDK cho frontend.
#
# CÁCH LẤY: Firebase Console → Project settings → General →
#           mục "Your apps" → chọn app Web → "SDK setup and configuration" → Config
#
# Sao chép file này thành `.env` rồi điền giá trị thật:
#     cp .env.example .env
#
# LƯU Ý: file `.env` đã được .gitignore chặn — KHÔNG commit lên GitHub.
# Thiếu file `.env` thì initializeApp() nhận toàn undefined và app sẽ TRẮNG TRANG.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
