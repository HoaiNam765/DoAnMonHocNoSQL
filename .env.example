# ============================================================================
# CẤU HÌNH DÙNG CHUNG CHO CẢ BACKEND VÀ FRONTEND
# ============================================================================
#
# Chép file này thành .env rồi điền thông tin thật vào:
#     cp .env.example .env
#
# File .env đã được .gitignore, KHÔNG BAO GIỜ commit lên GitHub.
#
# ----------------------------------------------------------------------------
# QUY TẮC QUAN TRỌNG NHẤT KHI THÊM BIẾN MỚI
# ----------------------------------------------------------------------------
# Biến có tiền tố VITE_ sẽ được Vite ghi thẳng vào file JS tải về trình duyệt —
# ai mở DevTools cũng đọc được. Biến không có tiền tố đó chỉ nằm ở máy chủ.
#
# => TUYỆT ĐỐI không đặt tiền tố VITE_ cho bất kỳ bí mật nào (mật khẩu Neo4j,
#    khoá Gemini, khoá webhook SePay). Đặt nhầm một lần là lộ vĩnh viễn.


# ============================================================================
# PHÍA MÁY CHỦ (backend) — KHÔNG được lộ ra ngoài
# ============================================================================

PORT=5000

# --- Neo4j ---------------------------------------------------------------
# Neo4j Aura: lấy trong file credentials tải về khi tạo instance
# Neo4j Desktop chạy máy: NEO4J_URI=bolt://localhost:7687
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Để trống là dùng database mặc định
NEO4J_DATABASE=

# --- Firebase ------------------------------------------------------------
# Web API Key trong Firebase Console > Project settings.
# Chỉ các script kiểm thử dùng (đổi custom token lấy ID token).
# File firebase-service-account.json phải đặt tại backend/, cũng không commit.
FIREBASE_WEB_API_KEY=

# --- Chatbot tư vấn (Google Gemini) --------------------------------------
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Thanh toán chuyển khoản (SePay) -------------------------------------
# Xem hướng dẫn đầy đủ ở SEPAY_SETUP.md
# Bỏ trống cả ba dòng thì khung QR tự ẩn, web vẫn chạy bình thường.
#
# ⚠️ SEPAY_ACCOUNT_NUMBER phải là tài khoản CỦA BẠN — điền nhầm số người khác
#    thì tiền khách chuyển sẽ vào tài khoản đó và không lấy lại được.
SEPAY_ACCOUNT_NUMBER=
# Tên ngân hàng viết liền không dấu, ví dụ: Vietcombank, MBBank, ACB, TPBank
SEPAY_BANK=
# Chuỗi bí mật bạn tự đặt, phải khớp với khai báo trong bảng điều khiển SePay.
# Ai biết chuỗi này có thể tự gọi webhook để "báo" đã trả tiền cho đơn bất kỳ.
SEPAY_WEBHOOK_APIKEY=


# ============================================================================
# PHÍA TRÌNH DUYỆT (frontend / Vite)
# ============================================================================
# Những giá trị dưới đây NẰM TRONG mã nguồn tải về máy khách — đó là thiết kế
# bình thường của Firebase Web SDK, không phải bí mật. Việc chặn truy cập trái
# phép do Firebase Security Rules và backend lo, không dựa vào việc giấu key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=xxxxx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Địa chỉ backend. Bỏ trống thì tự suy ra từ địa chỉ đang mở trang
# (localhost:5173 -> localhost:5000), nên chạy máy mình hay qua LAN đều đúng.
# Chỉ điền khi backend nằm ở máy khác: VITE_API_URL=http://192.168.1.50:5000/api
# VITE_API_URL=
